
#include <bits/stdc++.h>
using namespace std;

// Book Allocation Problem

bool isSolution(int arr[], int n, int m, long long mid) {
    int studentCount = 1;
    long long pageSum = 0;

    for (int i = 0; i < n; i++) {
        if (pageSum + arr[i] <= mid) {
            pageSum += arr[i];
        }
        else {
            studentCount++;

            if (studentCount > m || arr[i] > mid) {
                return false;
            }

            pageSum = arr[i];
        }
    }

    return true;
}

long long findSolution(int arr[], int n, int m) {
    if (m > n || n <= 0 || m <= 0) {
        return -1;
    }

    long long s = 0;
    long long e = 0;

    for (int i = 0; i < n; i++) {
        s = max(s, (long long)arr[i]);
        e += arr[i];
    }

    long long ans = e;

    while (s <= e) {
        long long mid = s + (e - s) / 2;

        if (isSolution(arr, n, m, mid)) {
            ans = mid;
            e = mid - 1;
        }
        else {
            s = mid + 1;
        }
    }

    return ans;
}

int main() {
    int arr[] = {10, 20, 30, 40};
    int n = 4;
    int m = 2;

    cout << findSolution(arr, n, m) << endl;

    return 0;
}
